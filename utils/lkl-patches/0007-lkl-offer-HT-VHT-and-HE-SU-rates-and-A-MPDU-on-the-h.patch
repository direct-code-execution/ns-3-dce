+	unsigned char mcs[4];
+	unsigned char nss[4];
+	unsigned short width[4]; /* MHz */
+	unsigned char sgi[4]; /* short (0.4 us) guard interval */
+	unsigned char ampdu; /* may be aggregated (Block Ack session) */
 };
 
+/* capabilities of a radio, given to lkl_sys_wifi_add (legacy rates only: 0) */
+#define LKL_WIFI_CAP_HT		1
+#define LKL_WIFI_CAP_VHT	2
+#define LKL_WIFI_CAP_HE		4
+
+#define LKL_WIFI_MODE_LEGACY	0
+#define LKL_WIFI_MODE_HT	1
+#define LKL_WIFI_MODE_VHT	2
+#define LKL_WIFI_MODE_HE	3
+
 #define LKL_WIFI_EV_RX		1
 #define LKL_WIFI_EV_TX_STATUS	2
 
@@ -174,6 +196,13 @@ struct lkl_wifi_event {
 	/* LKL_WIFI_EV_TX_STATUS */
 	unsigned char acked;
 	unsigned char attempts; /* in total, over the rate series */
+	/* LKL_WIFI_EV_RX, appended for HT/VHT/HE (0: legacy rate above) */
+	unsigned char mode; /* LKL_WIFI_MODE_* */
+	unsigned char mcs;
+	unsigned char nss;
+	unsigned char sgi;
+	unsigned short width; /* MHz */
+	unsigned int ampdu_ref; /* A-MPDU the frame came in, 0 for none */
 };
 
