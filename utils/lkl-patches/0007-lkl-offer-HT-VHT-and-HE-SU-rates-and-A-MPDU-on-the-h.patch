diff --git a/arch/lkl/include/uapi/asm/host_ops.h b/arch/lkl/include/uapi/asm/host_ops.h
index 68301eb8a..7e408441d 100644
--- a/arch/lkl/include/uapi/asm/host_ops.h
+++ b/arch/lkl/include/uapi/asm/host_ops.h
@@ -159,8 +159,30 @@ struct lkl_wifi_tx_info {
 	int power; /* dBm */
 	unsigned char no_ack;
 	unsigned char no_status; /* the host reports no outcome */
+	/*
+	 * Appended for HT/VHT/HE: hosts that only know the fields above see
+	 * legacy frames as before. Entry i of the rate series is the legacy
+	 * rate[i] with mode[i] LKL_WIFI_MODE_LEGACY, else mcs[i] on nss[i]
+	 * streams; count[i] 0 ends the series.
+	 */
