  */
-SYSCALL_DEFINE3(wifi_add, int, id, unsigned int, irq, const char __user *, umac)
+SYSCALL_DEFINE4(wifi_add, int, id, unsigned int, irq, const char __user *, umac,
+		unsigned int, caps)
 {
 	struct platform_device *pdev;
 	struct ieee80211_hw *hw;
@@ -445,6 +651,9 @@ SYSCALL_DEFINE3(wifi_add, int, id, unsigned int, irq, const char __user *, umac)
 	ieee80211_hw_set(hw, SIGNAL_DBM);
 	ieee80211_hw_set(hw, REPORTS_TX_ACK_STATUS);
 	ieee80211_hw_set(hw, MFP_CAPABLE);
+	ieee80211_hw_set(hw, AMPDU_AGGREGATION);
+	hw->max_rx_aggregation_subframes = LKL_WIFI_BA_SIZE;
+	hw->max_tx_aggregation_subframes = LKL_WIFI_BA_SIZE;
 	hw->queues = 4;
 	hw->max_rates = 4;
 	hw->max_rate_tries = 11;
@@ -453,7 +662,7 @@ SYSCALL_DEFINE3(wifi_add, int, id, unsigned int, irq, const char __user *, umac)
 				     BIT(NL80211_IFTYPE_AP) |
 				     BIT(NL80211_IFTYPE_MESH_POINT) |
 				     BIT(NL80211_IFTYPE_MONITOR);
-	lkl_wifi_setup_bands(wifi);
+	lkl_wifi_setup_bands(wifi, caps);
 	hw->wiphy->regulatory_flags |= REGULATORY_CUSTOM_REG;
