From 66ddafa723f6a3b4f913fb70ea15dc64367a42d8 Mon Sep 17 00:00:00 2001
From: Gabriel Ferreira <gabrielcarvfer@gmail.com>
Date: Thu, 29 Oct 2026 18:13:25 +0100
Subject: [PATCH] lkl: offer HT, VHT and HE (SU) rates and A-MPDU on the 
 host-carried mac80211 radio

Advertise HT (20/40 MHz, short GI, two streams) on both bands, VHT (80 MHz,
MCS 0-9, two streams) at 5 GHz and HE single user (MCS 0-11, two streams).
Give the host each entry of the rate series as an MCS, a number of
streams, a width and a guard interval, and the frames mac80211 may put in
A-MPDUs; the host aggregates them and keeps the Block Ack scoreboard, as
the hardware does, and reports each MPDU on its own. Take the HT/VHT/HE
rate of received frames from the host. The new fields are appended to
lkl_wifi_tx_info and lkl_wifi_event, so that hosts that do not know them
see legacy frames as before.

minstrel_ht has no HE rates, which HE devices choose in firmware: frames
for HE peers are sent as HE SU PPDUs at the MCS and number of streams it
chose.
---
 arch/lkl/drivers/wifi.c              | 251 ++++++++++++++++++++++++---
 arch/lkl/include/uapi/asm/host_ops.h |  29 ++++
 arch/lkl/kernel/syscalls.c           |   3 +-
 3 files changed, 261 insertions(+), 22 deletions(-)

diff --git a/arch/lkl/drivers/wifi.c b/arch/lkl/drivers/wifi.c
index e97e1c632..90b313c04 100644
--- a/arch/lkl/drivers/wifi.c
+++ b/arch/lkl/drivers/wifi.c
@@ -6,11 +6,18 @@
  * mac80211 go to the host through the wifi_tx host operation, as raw 802.11
  * frames without FCS, with the rate series chosen by rate control. The host
  * plays the part of the hardware: it contends for the medium, waits for the
- * acknowledgments and retries, then reports the outcome of each frame, in
- * order. The host raises the radio's interrupt when it has received frames or
- * transmission outcomes, which the interrupt fetches with wifi_poll.
+ * acknowledgments (or block acknowledgments) and retries, then reports the
+ * outcome of each frame, in order. The host raises the radio's interrupt
+ * when it has received frames or transmission outcomes, which the interrupt
+ * fetches with wifi_poll.
  *
- * Only legacy (non-HT) rates are offered, at 2.4 and 5 GHz.
+ * Legacy, HT (20/40 MHz) and VHT (up to 80 MHz) rates, two spatial
+ * streams, at 2.4 and 5 GHz, with A-MPDU aggregation (by the host), as the
+ * host asks when it creates the radio. HE
+ * (single user) is advertised too: as mac80211's rate control (minstrel_ht)
+ * has no HE rates, which real HE devices choose in firmware, the radio asks
+ * the host to send the frames of HE peers as HE SU PPDUs at the MCS and
+ * number of streams minstrel_ht chose.
  */
 
 #include <linux/module.h>
@@ -25,6 +32,7 @@
 #include <asm/host_ops.h>
 
 #define LKL_WIFI_MAX_FRAME 4096
+#define LKL_WIFI_BA_SIZE 64
 
 #define CHAN2G(_freq) { .band = NL80211_BAND_2GHZ, .center_freq = (_freq), \
 			.hw_value = (_freq), .max_power = 20 }
@@ -73,10 +81,50 @@ static const struct ieee80211_regdomain lkl_wifi_regdom = {
 	.alpha2 = "99",
 	.reg_rules = {
 		REG_RULE(2402, 2494, 40, 0, 20, 0),
-		REG_RULE(5140, 5860, 40, 0, 30, 0),
+		REG_RULE(5140, 5860, 80, 0, 30, 0),
 	}
 };
 
+/* HE single user, two spatial streams, MCS 0-11 (as mac80211_hwsim). */
+#define LKL_WIFI_HE_CAP(_width)						\
+	{								\
+		.has_he = true,						\
+		.he_cap_elem = {					\
+			.mac_cap_info[0] = IEEE80211_HE_MAC_CAP0_HTC_HE, \
+			.mac_cap_info[3] =				\
+				IEEE80211_HE_MAC_CAP3_OMI_CONTROL,	\
+			.phy_cap_info[0] = (_width),			\
+			.phy_cap_info[1] =				\
+				IEEE80211_HE_PHY_CAP1_DEVICE_CLASS_A,	\
+		},							\
+		.he_mcs_nss_supp = {					\
+			.rx_mcs_80 = cpu_to_le16(0xfffa),		\
+			.tx_mcs_80 = cpu_to_le16(0xfffa),		\
+			.rx_mcs_160 = cpu_to_le16(0xffff),		\
+			.tx_mcs_160 = cpu_to_le16(0xffff),		\
+			.rx_mcs_80p80 = cpu_to_le16(0xffff),		\
+			.tx_mcs_80p80 = cpu_to_le16(0xffff),		\
+		},							\
+	}
+
+static const struct ieee80211_sband_iftype_data lkl_wifi_he_2ghz[] = {
+	{
+		.types_mask = BIT(NL80211_IFTYPE_STATION) |
+			      BIT(NL80211_IFTYPE_AP),
+		.he_cap = LKL_WIFI_HE_CAP(
+			IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_IN_2G),
+	},
+};
+
+static const struct ieee80211_sband_iftype_data lkl_wifi_he_5ghz[] = {
+	{
+		.types_mask = BIT(NL80211_IFTYPE_STATION) |
+			      BIT(NL80211_IFTYPE_AP),
+		.he_cap = LKL_WIFI_HE_CAP(
+			IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_80MHZ_IN_5G),
+	},
+};
+
 struct lkl_wifi {
 	struct ieee80211_hw *hw;
 	struct platform_device *pdev;
@@ -107,8 +155,38 @@ lkl_wifi_band(struct lkl_wifi *wifi, enum nl80211_band band)
 	return wifi->hw->wiphy->bands[band];
 }
 
+/* One entry of the rate series, for the host. */
+static void lkl_wifi_tx_rate(struct lkl_wifi_tx_info *tx, int i,
+			     struct ieee80211_tx_rate *rate,
+			     struct ieee80211_supported_band *sband,
+			     struct ieee80211_sta *sta)
+{
+	tx->width[i] = 20;
+	if (rate->flags & IEEE80211_TX_RC_40_MHZ_WIDTH)
+		tx->width[i] = 40;
+	if (rate->flags & IEEE80211_TX_RC_80_MHZ_WIDTH)
+		tx->width[i] = 80;
+	tx->sgi[i] = !!(rate->flags & IEEE80211_TX_RC_SHORT_GI);
+	if (rate->flags & IEEE80211_TX_RC_MCS) {
+		tx->mode[i] = LKL_WIFI_MODE_HT;
+		tx->mcs[i] = rate->idx % 8;
+		tx->nss[i] = rate->idx / 8 + 1;
+	} else if (rate->flags & IEEE80211_TX_RC_VHT_MCS) {
+		tx->mode[i] = LKL_WIFI_MODE_VHT;
+		tx->mcs[i] = ieee80211_rate_get_vht_mcs(rate);
+		tx->nss[i] = ieee80211_rate_get_vht_nss(rate);
+	} else {
+		tx->mode[i] = LKL_WIFI_MODE_LEGACY;
+		tx->rate[i] = sband->bitrates[rate->idx].bitrate;
+		return;
+	}
+	/* The rate control of HE devices is in their firmware. */
+	if (sta && sta->deflink.he_cap.has_he)
+		tx->mode[i] = LKL_WIFI_MODE_HE;
+}
+
 static void lkl_wifi_send(struct lkl_wifi *wifi, struct sk_buff *skb,
-			  bool status)
+			  struct ieee80211_sta *sta, bool status)
 {
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
 	struct ieee80211_supported_band *sband;
@@ -121,19 +199,22 @@ static void lkl_wifi_send(struct lkl_wifi *wifi, struct sk_buff *skb,
 		tx.freq = wifi->channel->center_freq;
 		for (i = 0; i < ARRAY_SIZE(tx.rate); i++) {
 			struct ieee80211_tx_rate *rate = &info->control.rates[i];
+			bool mcs = rate->flags & (IEEE80211_TX_RC_MCS |
+						  IEEE80211_TX_RC_VHT_MCS);
 
 			if (rate->idx < 0 || !rate->count ||
-			    rate->idx >= sband->n_bitrates)
+			    (!mcs && rate->idx >= sband->n_bitrates))
 				break;
-			tx.rate[i] = sband->bitrates[rate->idx].bitrate;
+			lkl_wifi_tx_rate(&tx, i, rate, sband, sta);
 			tx.count[i] = rate->count;
 		}
 	}
 	tx.power = wifi->hw->conf.power_level;
 	tx.no_ack = !!(info->flags & IEEE80211_TX_CTL_NO_ACK);
 	tx.no_status = !status;
+	tx.ampdu = !!(info->flags & IEEE80211_TX_CTL_AMPDU);
 
-	if (wifi->started && wifi->channel && tx.rate[0])
+	if (wifi->started && wifi->channel && tx.count[0])
 		ret = lkl_ops->wifi_tx(wifi->id, skb->data, skb->len, &tx);
 
 	if (!status) {
@@ -150,7 +231,7 @@ static void lkl_wifi_tx(struct ieee80211_hw *hw,
 			struct ieee80211_tx_control *control,
 			struct sk_buff *skb)
 {
-	lkl_wifi_send(hw->priv, skb, true);
+	lkl_wifi_send(hw->priv, skb, control ? control->sta : NULL, true);
 }
 
 static void lkl_wifi_tx_status(struct lkl_wifi *wifi,
@@ -185,9 +266,64 @@ static void lkl_wifi_tx_status(struct lkl_wifi *wifi,
 	}
 	if (ev->acked && !(info->flags & IEEE80211_TX_CTL_NO_ACK))
 		info->flags |= IEEE80211_TX_STAT_ACK;
+	if (info->flags & IEEE80211_TX_CTL_AMPDU) {
+		/*
+		 * The host reports each MPDU of an A-MPDU on its own: as an
+		 * A-MPDU of one, which minstrel_ht adds up.
+		 */
+		info->flags |= IEEE80211_TX_STAT_AMPDU;
+		info->status.ampdu_len = 1;
+		info->status.ampdu_ack_len = !!ev->acked;
+	}
 	ieee80211_tx_status_irqsafe(wifi->hw, skb);
 }
 
+static void lkl_wifi_rx_rate(struct ieee80211_rx_status *status,
+			     const struct lkl_wifi_event *ev,
+			     struct ieee80211_supported_band *sband)
+{
+	int i;
+
+	switch (ev->width) {
+	case 40:
+		status->bw = RATE_INFO_BW_40;
+		break;
+	case 80:
+		status->bw = RATE_INFO_BW_80;
+		break;
+	default:
+		status->bw = RATE_INFO_BW_20;
+	}
+	switch (ev->mode) {
+	case LKL_WIFI_MODE_HT:
+		status->encoding = RX_ENC_HT;
+		status->rate_idx = ev->mcs + 8 * (ev->nss - 1);
+		if (ev->sgi)
+			status->enc_flags |= RX_ENC_FLAG_SHORT_GI;
+		break;
+	case LKL_WIFI_MODE_VHT:
+		status->encoding = RX_ENC_VHT;
+		status->rate_idx = ev->mcs;
+		status->nss = ev->nss;
+		if (ev->sgi)
+			status->enc_flags |= RX_ENC_FLAG_SHORT_GI;
+		break;
+	case LKL_WIFI_MODE_HE:
+		status->encoding = RX_ENC_HE;
+		status->rate_idx = ev->mcs;
+		status->nss = ev->nss;
+		status->he_gi = NL80211_RATE_INFO_HE_GI_0_8;
+		break;
+	default:
+		status->encoding = RX_ENC_LEGACY;
+		status->bw = RATE_INFO_BW_20;
+		status->rate_idx = 0;
+		for (i = 0; i < sband->n_bitrates; i++)
+			if (sband->bitrates[i].bitrate == ev->rate)
+				status->rate_idx = i;
+	}
+}
+
 static void lkl_wifi_rx(struct lkl_wifi *wifi, const struct lkl_wifi_event *ev)
 {
 	struct ieee80211_rx_status *status;
@@ -216,10 +352,11 @@ static void lkl_wifi_rx(struct lkl_wifi *wifi, const struct lkl_wifi_event *ev)
 	status->freq = ev->freq;
 	status->band = band;
 	status->signal = ev->signal;
-	status->rate_idx = 0;
-	for (i = 0; i < sband->n_bitrates; i++)
-		if (sband->bitrates[i].bitrate == ev->rate)
-			status->rate_idx = i;
+	lkl_wifi_rx_rate(status, ev, sband);
+	if (ev->ampdu_ref) {
+		status->flag |= RX_FLAG_AMPDU_DETAILS;
+		status->ampdu_reference = ev->ampdu_ref;
+	}
 	ieee80211_rx_irqsafe(wifi->hw, skb);
 }
 
@@ -252,9 +389,9 @@ static void lkl_wifi_beacon_tx(void *arg, u8 *mac, struct ieee80211_vif *vif)
 		return;
 	skb = ieee80211_beacon_get(wifi->hw, vif, 0);
 	if (skb)
-		lkl_wifi_send(wifi, skb, false);
+		lkl_wifi_send(wifi, skb, NULL, false);
 	while ((skb = ieee80211_get_buffered_bc(wifi->hw, vif)) != NULL)
-		lkl_wifi_send(wifi, skb, true);
+		lkl_wifi_send(wifi, skb, NULL, true);
 }
 
 static enum hrtimer_restart lkl_wifi_beacon(struct hrtimer *timer)
@@ -358,6 +495,33 @@ static u64 lkl_wifi_get_tsf(struct ieee80211_hw *hw, struct ieee80211_vif *vif)
 	return lkl_wifi_tsf();
 }
 
+/*
+ * Block Ack sessions: the host aggregates the frames mac80211 flags for
+ * A-MPDU, keeps the receive scoreboard and answers with block
+ * acknowledgments, as hardware does; the reordering is mac80211's.
+ */
+static int lkl_wifi_ampdu_action(struct ieee80211_hw *hw,
+				 struct ieee80211_vif *vif,
+				 struct ieee80211_ampdu_params *params)
+{
+	switch (params->action) {
+	case IEEE80211_AMPDU_TX_START:
+		return IEEE80211_AMPDU_TX_START_IMMEDIATE;
+	case IEEE80211_AMPDU_TX_STOP_CONT:
+	case IEEE80211_AMPDU_TX_STOP_FLUSH:
+	case IEEE80211_AMPDU_TX_STOP_FLUSH_CONT:
+		ieee80211_stop_tx_ba_cb_irqsafe(vif, params->sta->addr,
+						params->tid);
+		return 0;
+	case IEEE80211_AMPDU_TX_OPERATIONAL:
+	case IEEE80211_AMPDU_RX_START:
+	case IEEE80211_AMPDU_RX_STOP:
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
 static const struct ieee80211_ops lkl_wifi_ops = {
 	.tx = lkl_wifi_tx,
 	.wake_tx_queue = ieee80211_handle_wake_tx_queue,
@@ -370,13 +534,47 @@ static const struct ieee80211_ops lkl_wifi_ops = {
 	.vif_cfg_changed = lkl_wifi_vif_cfg_changed,
 	.link_info_changed = lkl_wifi_link_info_changed,
 	.get_tsf = lkl_wifi_get_tsf,
+	.ampdu_action = lkl_wifi_ampdu_action,
 	.add_chanctx = ieee80211_emulate_add_chanctx,
 	.remove_chanctx = ieee80211_emulate_remove_chanctx,
 	.change_chanctx = ieee80211_emulate_change_chanctx,
 	.switch_vif_chanctx = ieee80211_emulate_switch_vif_chanctx,
 };
 
-static void lkl_wifi_setup_bands(struct lkl_wifi *wifi)
+static void lkl_wifi_setup_ht(struct ieee80211_supported_band *band,
+			      unsigned int caps)
+{
+	struct ieee80211_sta_ht_cap *ht = &band->ht_cap;
+	struct ieee80211_sta_vht_cap *vht = &band->vht_cap;
+
+	if (!(caps & LKL_WIFI_CAP_HT))
+		return;
+	ht->ht_supported = true;
+	ht->cap = IEEE80211_HT_CAP_SUP_WIDTH_20_40 |
+		  IEEE80211_HT_CAP_SGI_20 |
+		  IEEE80211_HT_CAP_SGI_40 |
+		  IEEE80211_HT_CAP_DSSSCCK40;
+	ht->ampdu_factor = IEEE80211_HT_MAX_AMPDU_64K;
+	ht->ampdu_density = IEEE80211_HT_MPDU_DENSITY_NONE;
+	memset(&ht->mcs, 0, sizeof(ht->mcs));
+	ht->mcs.rx_mask[0] = 0xff;
+	ht->mcs.rx_mask[1] = 0xff;
+	ht->mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+
+	if (band->band != NL80211_BAND_5GHZ || !(caps & LKL_WIFI_CAP_VHT))
+		return;
+	vht->vht_supported = true;
+	vht->cap = IEEE80211_VHT_CAP_MAX_MPDU_LENGTH_3895 |
+		   IEEE80211_VHT_CAP_SHORT_GI_80 |
+		   (3 << IEEE80211_VHT_CAP_MAX_A_MPDU_LENGTH_EXPONENT_SHIFT);
+	/* MCS 0-9 on two streams, up to 780 Mb/s (80 MHz, long GI) */
+	vht->vht_mcs.rx_mcs_map = cpu_to_le16(0xfffa);
+	vht->vht_mcs.tx_mcs_map = cpu_to_le16(0xfffa);
+	vht->vht_mcs.rx_highest = cpu_to_le16(780);
+	vht->vht_mcs.tx_highest = cpu_to_le16(780);
+}
+
+static void lkl_wifi_setup_bands(struct lkl_wifi *wifi, unsigned int caps)
 {
 	struct ieee80211_supported_band *band;
 
@@ -392,6 +590,9 @@ static void lkl_wifi_setup_bands(struct lkl_wifi *wifi)
 	band->n_channels = ARRAY_SIZE(wifi->channels_2ghz);
 	band->bitrates = wifi->rates;
 	band->n_bitrates = ARRAY_SIZE(wifi->rates);
+	lkl_wifi_setup_ht(band, caps);
+	if (caps & LKL_WIFI_CAP_HE)
+		ieee80211_set_sband_iftype_data(band, lkl_wifi_he_2ghz);
 	wifi->hw->wiphy->bands[NL80211_BAND_2GHZ] = band;
 
 	band = &wifi->bands[NL80211_BAND_5GHZ];
@@ -400,14 +601,19 @@ static void lkl_wifi_setup_bands(struct lkl_wifi *wifi)
 	band->n_channels = ARRAY_SIZE(wifi->channels_5ghz);
 	band->bitrates = wifi->rates + LKL_WIFI_OFDM_RATES;
 	band->n_bitrates = ARRAY_SIZE(wifi->rates) - LKL_WIFI_OFDM_RATES;
+	lkl_wifi_setup_ht(band, caps);
+	if (caps & LKL_WIFI_CAP_HE)
+		ieee80211_set_sband_iftype_data(band, lkl_wifi_he_5ghz);
 	wifi->hw->wiphy->bands[NL80211_BAND_5GHZ] = band;
 }
 
